# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=your_database_name
DATABASE_SSL=false

# Backward-compatible database names
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Auth
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
AUTH_SESSION_SECRET=your_auth_session_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Pipeline
PIPELINE_WORKSPACE_DIR=.workspace/pipeline
PIPELINE_JOB_ATTEMPTS=1

# GitHub Actions
GITHUB_TOKEN=your_github_token
GITHUB_ACTIONS_WORKFLOW_FILE=deploy.yml

# AWS / ECR
AWS_REGION=your_aws_region
AWS_ACCOUNT_ID=your_aws_account_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
ECR_REPOSITORY_PREFIX=mini-paas

# Trivy / Security Scanning
TRIVY_TIMEOUT_SECONDS=300
SECURITY_BLOCK_CRITICAL=true
SECURITY_BLOCK_HIGH=true
SECURITY_MEDIUM_APPROVAL_THRESHOLD=5
SECURITY_ALLOW_HIGH_CRITICAL_OVERRIDE=false
SECURITY_ALLOW_MEDIUM_APPROVAL=true
